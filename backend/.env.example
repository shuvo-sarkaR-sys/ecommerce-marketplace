# MongoDB Atlas connection string (create a free-tier cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/maison?retryWrites=true&w=majority

# Random long strings -- generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

PORT=5000
NODE_ENV=development

# The frontend's origin -- required for CORS to allow credentialed requests
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required only when creating an admin from /admin/register
ADMIN_SETUP_KEY=replace-with-a-private-admin-setup-key

# Added when Cloudinary image uploads are wired in (seller product images)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
